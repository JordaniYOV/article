PLANETARY_API_DATABASE_PATH=.state/planetary.sqlite3
PLANETARY_API_SQL_ECHO=false
PLANETARY_API_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PLANETARY_API_MAX_UPLOAD_BYTES=268435456
PLANETARY_API_MAX_UNPACKED_BYTES=1073741824
PLANETARY_API_MAX_ARCHIVE_FILES=10000
PLANETARY_API_DOWNLOAD_TIMEOUT=30
PLANETARY_API_WORKER_POLL_SECONDS=2
# Generate one token and use the SAME value for API and both model services.
# Example generation command: python -c "import secrets; print(secrets.token_hex(32))"
PLANETARY_API_SERVICE_TOKEN=
PLANETARY_API_DISPATCHER_ENABLED=true
PLANETARY_API_SPACELLAVA_SERVICE_URL=http://127.0.0.1:8001
PLANETARY_API_IBM_SERVICE_URL=http://127.0.0.1:8002
PLANETARY_API_HEADS_SERVICE_URL=http://127.0.0.1:8003
PLANETARY_API_SERVICE_HTTP_TIMEOUT=5
# Safe default: no weights/GPU; all outputs are marked non-scientific mock.
# Set false in each model-service environment only for an authorized GPU smoke test.
PLANETARY_API_SERVICE_MOCK=true
# Optional per-job subprocess limit, seconds; 0 disables it.
PLANETARY_API_SERVICE_MAX_JOB_SECONDS=0

$check = @'
import os, sys
sys.path.insert(0, 'src')
from benchmark_services.common.settings import Settings, WORKSPACE_ROOT
from dotenv import dotenv_values

p = WORKSPACE_ROOT / '.env'
print('ENV_FILE:', p)
print('FILE_EXISTS:', p.is_file())
try:
    values = dotenv_values(p, encoding='utf-8')
    print('TOKEN_IN_FILE:', bool(values.get('PLANETARY_API_SERVICE_TOKEN')))
    print('ENV_OVERRIDE:', 'PLANETARY_API_SERVICE_TOKEN' in os.environ)
    print('UTF8_BOM:', p.is_file() and p.read_bytes().startswith(b'\xef\xbb\xbf'))
    print('TOKEN_LOADED:', bool(Settings().service_token))
except Exception as error:
    print('CONFIG_ERROR:', type(error).__name__)
'@

& .\.venv-api\Scripts\python.exe -B -c $check